{
  "name": "admin-system-game",
  "version": "0.1.0",
  "repository": "https://github.com/Taoister39/admin-system-game",
  "type": "module",
  "scripts": {
    "build": "rsbuild build",
    "dev": "rsbuild dev",
    "dev:web": "rsbuild dev --environment web",
    "preview": "rsbuild preview",
    "lint": "biome check .",
    "lint:write": "biome check . --write",
    "prepare": "simple-git-hooks",
    "test": "rstest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test:browser": "node scripts/browser-smoke.cjs",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "package:win": "pnpm build && pnpm --dir packer build --win portable"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.5",
    "antd-style": "^4.1.0",
    "i18next": "^25.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.3",
    "react-router-dom": "^7.5.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@rsbuild/core": "catalog:",
    "@rsbuild/plugin-react": "^1.1.1",
    "@rstest/core": "^0.0.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "electron": "catalog:packer",
    "nano-staged": "^0.8.0",
    "playwright": "1.63.0",
    "rsbuild-plugin-electron": "workspace:*",
    "simple-git-hooks": "^2.13.0",
    "typescript": "catalog:"
  }
}
